# Copier en backend/.env — ne jamais commiter le fichier .env
NODE_ENV=development
PORT=3001

# ── Firebase ──
# Local : émulateurs (pnpm emulators). Projet « demo-* » : n'atteint jamais un vrai projet.
FIREBASE_PROJECT_ID=demo-salve-italia
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Production : FIREBASE_PROJECT_ID=salve-italia, AUCUNE variable *_EMULATOR_HOST, et le compte de service
# (console Firebase → Paramètres → Comptes de service → Générer une clé), JSON brut ou encodé en base64.
# Contourne les règles de sécurité : backend uniquement, jamais exposé au frontend (CDC §18).
FIREBASE_SERVICE_ACCOUNT=
# Optionnel (défaut : <projet>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# MFA obligatoire pour les admins (checklist sécurité). Ne désactiver qu'en dev local :
# l'émulateur Firebase Auth ne gère pas la MFA TOTP.
REQUIRE_ADMIN_MFA=true


# Phase 3 — agent ambassade IA (clés backend uniquement, jamais dans le frontend)
# nvidia (défaut) | gemini | claude | fake (agent factice sans clé ni coût, refusé si NODE_ENV=production)
AI_PROVIDER=nvidia
# Clé API NVIDIA (« nvapi-… ») : https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# ⚠️ Essai gratuit build.nvidia.com : évaluation uniquement, sans production ni données personnelles.
# Développement avec données fictives uniquement. En production : accès NVIDIA AI Enterprise ou NIM
# auto-hébergé (NVIDIA_BASE_URL) + NVIDIA_PRODUCTION_ACCESS=true (obligatoire).
NVIDIA_PRODUCTION_ACCESS=false
# Tarifs en $ / million de tokens, pour le suivi des coûts (0 pendant l'essai gratuit)
NVIDIA_INPUT_PRICE_PER_MTOK=0
NVIDIA_OUTPUT_PRICE_PER_MTOK=0
# Optionnel : AI_PROVIDER=gemini
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# ⚠️ Palier gratuit : Google interdit d'y envoyer des données personnelles et peut faire relire les échanges.
# Développement avec données fictives uniquement. En production : facturation activée + GEMINI_PAID_TIER=true (obligatoire).
GEMINI_PAID_TIER=false
# Tarifs du palier payant en $ / million de tokens (page tarifs Gemini), pour le suivi des coûts
GEMINI_INPUT_PRICE_PER_MTOK=0
GEMINI_OUTPUT_PRICE_PER_MTOK=0
# Optionnel : AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Quotas (EF-22 / EF-59) — à valider avec le centre
EMBASSY_MAX_TURNS=12
EMBASSY_WEEKLY_SESSION_LIMIT=5
EMBASSY_MONTHLY_COST_LIMIT_USD=5

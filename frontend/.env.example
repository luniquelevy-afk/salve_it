# Copier en frontend/.env — uniquement des valeurs publiques (aucun compte de service, aucune clé IA)

# ── Développement local : émulateurs Firebase (pnpm emulators) ──
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-salve-italia
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Production (Vercel) : configuration web du projet « salve-italia » (console Firebase →
# Paramètres du projet → Vos applications). Valeurs publiques par conception ; ne pas définir
# VITE_FIREBASE_AUTH_EMULATOR_HOST.
# VITE_FIREBASE_API_KEY=AIzaSyDQVbtQf85V3HPiHb2lklnvOxuNKN6SsUM
# VITE_FIREBASE_AUTH_DOMAIN=salve-italia.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=salve-italia
# VITE_FIREBASE_APP_ID=1:204417832318:web:3a84910f4a5b73c1404f2f

# Vide en dev (proxy Vite vers le backend) ; URL Railway/Render en production
VITE_API_URL=

# Déconnexion automatique après inactivité (EF-05 — durée à valider avec le client)
VITE_IDLE_TIMEOUT_MINUTES=30
